{
  "compilerOptions": {
    "typeRoots": [
      "./node_modules/@types",
      "src/types"
    ],
    "target": "es2020",
    "module": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "src/types"
  ],
  "exclude": [
    "node_modules"
  ]
}